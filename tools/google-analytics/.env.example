# Copy to .env locally. Never commit .env or any token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/oauth2callback

# Provide this through a secret manager or a protected process environment.
# The tool never prints or writes the token.
GOOGLE_REFRESH_TOKEN=

